NODE_ENV=development
PORT=5001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=moa_reform_feedback
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgresql-password
DB_SSL=false
ALLOWED_ORIGINS=http://localhost:3000
MINISTRY_ADMIN_USERNAME=admin
MINISTRY_ADMIN_PASSWORD=replace-with-a-strong-password
MINISTRY_ADMIN_SESSION=replace-with-a-long-random-session-secret
APP_PUBLIC_URL=http://localhost:3000
# To reuse FTMS Gmail delivery, set this to the absolute path of FTMS backend/.env.
FTMS_EMAIL_ENV_FILE=
# The SMTP_* settings below are only used when FTMS_EMAIL_ENV_FILE is empty.
SMTP_HOST=replace-with-ministry-mail-server
SMTP_PORT=587
SMTP_FROM=survey@moa.gov.et
# Set both SMTP_USER and SMTP_PASSWORD when the mail server requires authentication.
SMTP_USER=
SMTP_PASSWORD=
